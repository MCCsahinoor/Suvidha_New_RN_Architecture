2a\u0915\u0947 \u0926\u0940\u0935\u093e\u0930\u094b\u0902 \u092a\u0930 \u0926\u0947\u0916\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0936\u0947\u0921\u094d\u0938 \u0938\u0947 \u092e\u093f\u0932\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u092b\u093f\u0930 \u092d\u0940 \u090f\u0915 \u0905\u0902\u0924\u0930 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u0939\u0948 - \u0907\u0938 \u0938\u093e\u0907\u091f \u092a\u0930 \u0926\u093f\u0916\u093e\u090f \u0917\u090f \u0936\u0947\u0921\u094d\u0938 \u0938\u0902\u0915\u0947\u0924\u093e\u0924\u094d\u092e\u0915 \u0939\u0948\u0902 \u0914\u0930 \u092e\u0949\u0928\u093f\u091f\u0930/\u092b\u094b\u0928 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u0948\u0932\u093f\u092c\u094d\u0930\u0947\u0936\u0928 (\u091a\u092e\u0915, \u0915\u0902\u091f\u094d\u0930\u093e\u0938\u094d\u091f, \u0906\u0926\u093f) \u0914\u0930 \u0930\u093f\u091c\u093c\u0949\u0932\u094d\u092f\u0942\u0936\u0928 \u0915\u0947 \u0938\u093e\u0925-\u0938\u093e\u0925 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u092a\u0947\u0902\u091f \u0930\u0902\u0917\u094b\u0902 \u0915\u093e \u0938\u091f\u0940\u0915 \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u0924\u094d\u0935 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u0905\u0902\u0924\u093f\u092e \u0938\u0924\u0939 \u092a\u0930 \u0932\u093e\u0917\u0942 \u0936\u0947\u0921 \u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0914\u0930 \u0915\u0943\u0924\u094d\u0930\u093f\u092e \u092a\u094d\u0930\u0915\u093e\u0936, \u0930\u0902\u0917 \u0915\u0940 \u0917\u0939\u0930\u093e\u0908, \u0938\u0924\u0939 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0914\u0930 \u0938\u0924\u0939 \u0915\u0940 \u092b\u093f\u0928\u093f\u0936 \u0915\u0947 \u0915\u093e\u0930\u0923 \u092d\u0940 \u092d\u093f\u0928\u094d\u0928\u0924\u093e \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948, \u0907\u0938\u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u0915\u0908 \u0905\u0928\u094d\u092f \u0915\u093e\u0930\u0915 \u092d\u0940 \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",Overview:"\u0938\u093e\u0930\u093e\u0902\u0936",PleaseWaitDownloadingInProgress:"\u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902.. \u0921\u093e\u0909\u0928\u0932\u094b\u0921\u093f\u0902\u0917 \u092a\u094d\u0930\u0917\u0924\u093f \u092a\u0930 \u0939\u0948",Downloading:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921\u093f\u0902\u0917...",metallic:"\u0927\u093e\u0924\u094d\u0935\u093f\u0915",nonMetallic:"\u0905\u0927\u093e\u0924\u094d\u0935\u093f\u0915",metallicDesign:"\u0927\u093e\u0924\u094d\u0935\u093f\u0915 \u0921\u093f\u091c\u093c\u093e\u0907\u0928",nonMetallicDesign:"\u0905\u0927\u093e\u0924\u094d\u0935\u093f\u0915 \u0921\u093f\u091c\u093c\u093e\u0907\u0928","E-Value Token":"\u0908-\u092e\u0942\u0932\u094d\u092f \u091f\u094b\u0915\u0928",tokens:"\u091f\u094b\u0915\u0928",encashedThrough:"\u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0928\u0915\u0926 \u0915\u093f\u092f\u093e \u0917\u092f\u093e",fromDate:"\u0938\u0947 \u0926\u093f\u0928\u093e\u0902\u0915",toDate:"\u0924\u0915 \u0926\u093f\u0928\u093e\u0902\u0915",meetType:"\u092e\u0940\u091f \u092a\u094d\u0930\u0915\u093e\u0930",meetDate:"\u092e\u0940\u091f \u0926\u093f\u0928\u093e\u0902\u0915",agenda:"\u0915\u093e\u0930\u094d\u092f\u0938\u0942\u091a\u0940",noContactFound:"\u0915\u094b\u0908 \u0938\u0902\u092a\u0930\u094d\u0915 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e",selectStartEndDateProperly:"\u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0914\u0930 \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0924\u093f\u0925\u093f \u0938\u0939\u0940 \u0938\u0947 \u091a\u0941\u0928\u0947\u0902\u0964",maxFil